# OAuth: browser-visible API base (must match Google redirect URI host).
# Dev with Vite proxy: http://localhost:5173
OAUTH_API_PUBLIC_BASE_URL=http://localhost:5173
# SPA origin for post-login redirect (?token= / ?error=)
FRONTEND_OAUTH_REDIRECT_BASE=http://localhost:5173

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Weibo OAuth (https://open.weibo.com/apps)
WEIBO_OAUTH_APP_KEY=
WEIBO_OAUTH_APP_SECRET=

# QQ Connect (https://connect.qq.com/manage.html)
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_KEY=

# Alipay OAuth login: reuse payment keys (ALIPAY_APP_ID, ALIPAY_PRIVATE_KEY,
# ALIPAY_PLATFORM_PUBLIC_KEY, ALIPAY_GATEWAY). Add authorized redirect:
# {OAUTH_API_PUBLIC_BASE_URL}/api/auth/oauth/alipay/callback
# Enable capability: third-party app / 获取会员信息 (auth_user) per console.
