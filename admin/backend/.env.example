# Copy to .env and fill in values
DATABASE_URL=mysql+aiomysql://user:password@mysql:3306/notebooklm
SECRET_KEY=change-me-to-a-random-secret-key
REDIS_URL=redis://redis:6379/0

# Optional: Langfuse LLM tracing (omit or leave empty to disable)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
